    {
      "name": "policy_sec1_title",
      "value": "1. NDT7 Overview"
    },
    {
      "name": "policy_sec1_body",
      "value": "NDT7 (Network Diagnostic Tool) performs active network tests to measure throughput, round-trip latency, and packet loss using M-Lab open infrastructure."
    },
    {
      "name": "policy_sec2_title",
      "value": "2. Data Collected"
    },
    {
      "name": "policy_sec2_body",
      "value": "• Public IP address & approximate ISP/AS network\n• Download & upload throughput measurements\n• TCP diagnostics (RTT, jitter, retransmission)\n• Timestamps and test duration"
    },
    {
      "name": "policy_sec3_title",
      "value": "3. Public Open Data Sharing"
    },
    {
      "name": "policy_sec3_body",
      "value": "All measurement results are published publicly and permanently in M-Lab's open research dataset (BigQuery and Google Cloud Storage) to support global Internet research."
    },
    {
      "name": "policy_sec4_title",
      "value": "4. Privacy & Consent"
    },
    {
      "name": "policy_sec4_body",
      "value": "No personal identification, contacts, device files, or precise GPS coordinates are ever accessed. By clicking Agree, you accept the M-Lab Data Policy."
    },
